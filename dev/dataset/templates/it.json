    "unito a {parent_type} #{index} tramite il punto {point}",
    "legato a {parent_type} all'indice {index}, punto {point}"
  ],
  "conjunction": " e ",
  "property_clauses": ["con {prop} a {value}", "con {prop} uguale a {value}", "dove {prop} è {value}", "con {prop}: {value}"],
  "orientation_clauses": [
