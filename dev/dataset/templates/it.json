{
  "verbs": ["aggiungi", "crea", "genera", "posiziona", "inserisci", "metti", "piazza"],
  "object_ref": ["un {type}", "un oggetto {type}", "un blocco {type}", "un elemento {type}", "{type}", "un solo {type}"],
  "color_clauses": ["di colore {color}", "dipinto di {color}", "con il colore {color}", "usando il colore {color}"],
  "colors": {
    "red": ["rosso"], "orange": ["arancione"], "yellow": ["giallo"], "green": ["verde"],
    "cyan": ["ciano", "azzurro", "turchese"], "blue": ["blu"], "purple": ["viola"],
    "pink": ["rosa"], "brown": ["marrone"], "white": ["bianco"], "gray": ["grigio"], "black": ["nero"]
  },
  "connection_clauses": [
    "collegato a {parent_type} #{index} al punto {point}",
