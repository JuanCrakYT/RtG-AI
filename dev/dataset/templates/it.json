    "ruotato di {value}° sull'asse {axis}",
    "con un orientamento di {value}° sull'asse {axis}",
    "con la rotazione dell'asse {axis} a {value}°"
  ],
  "boolean_words": {
    "true": ["attivo", "acceso", "abilitato", "sì", "vero"],
    "false": ["disattivato", "spento", "disabilitato", "no", "falso"]
  },
  "property_names": {
    "Bullets": ["numero di proiettili", "numero di colpi"], "Speed": ["velocità"], "Rotation": ["rotazione"],
    "Volume": ["volume"], "Quantity": ["quantità"], "Text": ["testo"], "Length": ["lunghezza"],
    "Visible": ["visibilità"], "Activated": ["stato di attivazione"], "Shooting": ["sparo"], "ItemTurn": ["rotazione dell'oggetto"]
  },
  "sentence_patterns": [
    "{verb} {object} {color} {connections} {props}",
    "{verb} {object} {connections} {color} {props}",
    "{verb} {object} {props} {color} {connections}"
  ]
}