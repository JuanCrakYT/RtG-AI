{
  "verbs": ["Создай", "Добавь", "Сгенерируй", "Размести", "Поставь", "Вставь"],
  "object_ref": ["объект {type}", "блок {type}", "элемент {type}", "компонент {type}", "{type}", "один объект {type}"],
  "color_clauses": ["цвет: {color}", "цвет {color}", "с цветом: {color}", "покрашенный в {color}"],
  "colors": {
    "red": ["красный"], "orange": ["оранжевый"], "yellow": ["жёлтый"], "green": ["зелёный"],
    "cyan": ["голубой", "бирюзовый"], "blue": ["синий"], "purple": ["фиолетовый"],
    "pink": ["розовый"], "brown": ["коричневый"], "white": ["белый"], "gray": ["серый"], "black": ["чёрный"]
  },
  "connection_clauses": [
    "с подключением к {parent_type} #{index} в точке {point}",
    "с креплением к {parent_type} #{index} в точке {point}",
    "соединение с {parent_type} #{index}, точка {point}",
    "связь с {parent_type} #{index} через точку {point}"
  ],
  "conjunction": " и ",
  "property_clauses": ["{prop}: {value}", "{prop} = {value}", "параметр {prop} равен {value}", "параметр {prop}: {value}"],
  "orientation_clauses": [
    "ориентация по оси {axis}: {value}°",
    "поворот по оси {axis}: {value}°",
    "параметр ориентации по оси {axis} равен {value}°",
    "повёрнутый на {value}° по оси {axis}"
  ],
  "boolean_words": {"true": ["вкл", "да", "true", "истина"], "false": ["выкл", "нет", "false", "ложь"]},
  "property_names": {
    "Bullets": ["патроны", "боеприпасы", "количество пуль"], "Speed": ["скорость"], "Rotation": ["вращение"],
    "Volume": ["громкость"], "Quantity": ["количество"], "Text": ["текст"], "Length": ["длина"],
    "Visible": ["видимость"], "Activated": ["активация"], "Shooting": ["стрельба"], "ItemTurn": ["поворот предмета"]
  },
  "sentence_patterns": [
    "{verb} {object} {color} {connections} {props}",
    "{verb} {object} {connections} {color} {props}",
    "{verb} {object} {props} {color} {connections}"
  ]
}